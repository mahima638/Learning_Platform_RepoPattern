@model List<LearningPlatformRepoPattern.Models.Topic>

@{
    ViewData["Title"] = "Topic";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>Topic</h2>
            <p class="text-muted">
                Manage learning platform topics.
            </p>
        </div>

        <button type="button"
                class="btn btn-primary"
                onclick="openAddModal()">
            Add Topic
        </button>

    </div>


    <div class="mb-3">

        <input type="text"
               id="searchTopic"
               class="form-control"
               placeholder="Search Topic..."
               style="max-width:350px;" />

    </div>


    <div class="table-responsive">

        <table class="table table-bordered table-striped"
               id="topicTable">

            <thead class="table-dark">

                <tr>

                    <th style="width:60px;">ID</th>

                    <th>Master Course</th>

                    <th>Sub Course</th>

                    <th>Topic</th>

                    <th>Video URL</th>

                    <th>Status</th>

                    <th>Action</th>

                </tr>

            </thead>

            <tbody>

                @{
                    int rowNumber = 1;
                }

                @foreach (var item in Model)
                {
                    <tr>

                        <td class="row-number">
                            @rowNumber
                        </td>

                        <td>
                            @item.MasterCourse?.CourseName
                        </td>

                        <td>
                            @item.SubCourse?.SubCourseName
                        </td>

                        <td>
                            @item.TopicName
                        </td>

                        <td>

                            @if (!string.IsNullOrEmpty(item.VideoUrl))
                            {
                                <a href="@item.VideoUrl"
                                   target="_blank">
                                    View Video
                                </a>
                            }
                            else
                            {
                                <span>N/A</span>
                            }

                        </td>

                        <td>

                            @if (item.Status == "Active")
                            {
                                <span class="badge bg-success">
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    @item.Status
                                </span>
                            }

                        </td>

                        <td>

                            <button type="button"
                                    class="btn btn-warning btn-sm"
                                    onclick="openEditModal(@item.Id)">
                                Edit
                            </button>

                            <form asp-action="Delete"
                                  method="post"
                                  style="display:inline;">

                                <input type="hidden"
                                       name="id"
                                       value="@item.Id" />

                                <button type="submit"
                                        class="btn btn-danger btn-sm"
                                        onclick="return confirm('Are you sure you want to delete this Topic?');">
                                    Delete
                                </button>

                            </form>

                        </td>

                    </tr>

                    rowNumber++;
                }

            </tbody>

        </table>

    </div>

</div>


<!-- Topic Modal -->

<div class="modal fade"
     id="topicModal"
     tabindex="-1">

    <div class="modal-dialog">

        <div class="modal-content">

            <form id="topicForm"
                  method="post"
                  enctype="multipart/form-data">

                <div class="modal-header">

                    <h5 class="modal-title"
                        id="topicModalTitle">
                        Add Topic
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <div class="modal-body">

                    <input type="hidden"
                           id="Id"
                           name="Id"
                           value="0" />


                    <div class="mb-3">

                        <label class="form-label">
                            Master Course
                        </label>

                        <select id="MasterCourseId"
                                name="MasterCourseId"
                                class="form-control"
                                required>

                            <option value="">
                                Select Master Course
                            </option>

                            @foreach (var course in ViewBag.MasterCourses)
                            {
                                <option value="@course.Id">
                                    @course.CourseName
                                </option>
                            }

                        </select>

                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            Sub Course
                        </label>

                        <select id="SubCourseId"
                                name="SubCourseId"
                                class="form-control"
                                required>

                            <option value="">
                                Select Sub Course
                            </option>

                        </select>

                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            Topic
                        </label>

                        <input type="text"
                               id="TopicName"
                               name="TopicName"
                               class="form-control"
                               required />

                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            Video URL
                        </label>

                        <input type="text"
                               id="VideoUrl"
                               name="VideoUrl"
                               class="form-control" />

                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            Status
                        </label>

                        <select id="Status"
                                name="Status"
                                class="form-control"
                                required>

                            <option value="Active">
                                Active
                            </option>

                            <option value="Inactive">
                                Inactive
                            </option>

                        </select>

                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            Thumbnail
                        </label>

                        <input type="file"
                               name="thumbnail"
                               class="form-control" />

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-primary">
                        Save Topic
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts
{
    <script>

        function openAddModal() {

            $("#topicModalTitle").text("Add Topic");

            $("#topicForm").attr("action", "/Topic/Add");

            $("#Id").val(0);

            $("#MasterCourseId").val("");

            $("#SubCourseId").html(
                '<option value="">Select Sub Course</option>'
            );

            $("#TopicName").val("");

            $("#VideoUrl").val("");

            $("#Status").val("Active");

            $("#topicModal").modal("show");
        }


        $("#MasterCourseId").change(function() {

            var masterCourseId =
                $(this).val();

            $("#SubCourseId").html(
                '<option value="">Select Sub Course</option>'
            );

            if (masterCourseId === "") {
                return;
            }

            $.get(
                "/Topic/GetSubCourses",
                {
                    masterCourseId: masterCourseId
                },
                function(data) {

                    $.each(data, function(i, item) {

                        $("#SubCourseId").append(
                            '<option value="' +
                            item.id +
                            '">' +
                            item.name +
                            '</option>'
                        );

                    });

                }
            );

        });


        function openEditModal(id) {

            $.get(
                "/Topic/GetById",
                {
                    id: id
                },
                function(data) {

                    if (!data) {

                        alert("Unable to load Topic.");

                        return;
                    }

                    $("#topicModalTitle")
                        .text("Edit Topic");

                    $("#topicForm")
                        .attr("action", "/Topic/Edit");

                    $("#Id").val(data.id);

                    $("#MasterCourseId")
                        .val(data.masterCourseId);


                    $("#SubCourseId").html(
                        '<option value="">Select Sub Course</option>'
                    );


                    $.get(
                        "/Topic/GetSubCourses",
                        {
                            masterCourseId:
                                data.masterCourseId
                        },
                        function(subCourses) {

                            $.each(
                                subCourses,
                                function(i, item) {

                                    $("#SubCourseId")
                                        .append(
                                            '<option value="' +
                                            item.id +
                                            '">' +
                                            item.name +
                                            '</option>'
                                        );

                                }
                            );


                            $("#SubCourseId")
                                .val(data.subCourseId);

                        }
                    );


                    $("#TopicName")
                        .val(data.topicName);

                    $("#VideoUrl")
                        .val(data.videoUrl);

                    $("#Status")
                        .val(data.status);

                    $("#topicModal")
                        .modal("show");

                }
            );

        }


        $("#searchTopic").on(
            "keyup",
            function() {

                var search =
                    $(this)
                        .val()
                        .toLowerCase();

                $("#topicTable tbody tr")
                    .each(function() {

                        var row =
                            $(this);

                        row.toggle(
                            row.text()
                                .toLowerCase()
                                .indexOf(search) > -1
                        );

                    });

            }
        );

    </script>


    @if (TempData["Message"] != null)
    {
        <script>

            alert('@TempData["Message"]');

        </script>
    }
}