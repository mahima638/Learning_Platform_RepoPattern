@model List<LearningPlatformRepoPattern.Models.MyCourseViewModel>

@{
    ViewData["Title"] = "My Courses";
}

<!-- Bootstrap 5 CDN -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet">

<div class="container py-5">

    <!-- Page Heading -->
    <div class="text-center mb-5">
        <h1 class="fw-bold">My Courses</h1>

        <p class="text-secondary">
            Continue learning from your enrolled courses
        </p>
    </div>


    @if (Model == null || Model.Count == 0)
    {
        <!-- No Courses -->
        <div class="alert alert-info text-center">

            <h5 class="alert-heading">
                No Courses Found
            </h5>

            <p class="mb-0">
                You have not enrolled in any courses yet.
            </p>

        </div>
    }
    else
    {
        <!-- Course Cards -->
        <div class="row g-4">

            @foreach (var course in Model)
            {
                <div class="col-12 col-md-6 col-lg-4">

                    <div class="card h-100 shadow">

                        <!-- Course Image -->
                        <img src="@Url.Content("~/" + (course.Mthumbnail ?? "").TrimStart('/'))"
                             class="card-img-top"
                             alt="@course.Mname"
                             style="height:220px; object-fit:cover;">


                        <div class="card-body">

                            <!-- Sub Course Name -->
                            <h5 class="card-title fw-bold">
                                @course.Sname
                            </h5>


                            <!-- Master Course -->
                            <p class="card-text">
                                <strong>Course:</strong>
                                @course.Mname
                            </p>


                            <!-- Status -->
                            <p class="card-text">

                                <strong>Status:</strong>

                                <span class="badge bg-success">
                                    @course.Sstatus
                                </span>

                            </p>


                            <!-- Amount -->
                            <p class="card-text">

                                <strong>Amount:</strong>

                                <span class="text-success fw-bold">
                                    ₹@course.Samount
                                </span>

                            </p>


                            <!-- Play Course -->
                            <a asp-controller="MyCourses"
                               asp-action="WatchVideo"
                               asp-route-sid="@course.Sid"
                               class="btn btn-primary w-100">

                                ▶ Play Course

                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>