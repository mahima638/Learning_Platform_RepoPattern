@model List<LearningPlatformRepoPattern.Models.MasterCourse>

<div class="container mt-4">

    @* @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    } *@

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Master Course</h2>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#courseModal" onclick="openAddModal()">
            Add Master Course
        </button>
    </div>

    <table class="table table-striped table-bordered" id="courseTable" style="width:100%">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Master Course</th>
                <th>Status</th>
                <th>Thumbnail</th>
                <th>Created At</th>
                <th>Created By</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.CourseName</td>
                    <td>
                        @if (item.Status == "Active")
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </td>
                    <td>
                        @if (!string.IsNullOrEmpty(item.ThumbnailPath))
                        {
                            <img src="@item.ThumbnailPath" width="50" height="50" style="object-fit:cover; border-radius:4px;" />
                        }
                    </td>
                    <td>@item.CreatedAt</td>
                    <td>@item.CreatedBy</td>
                    <td>
                        <button type="button" class="btn btn-sm btn-warning"
                                data-bs-toggle="modal" data-bs-target="#courseModal"
                                onclick="openEditModal(@item.Id, '@item.CourseName', '@item.Status')">
                            Edit
                        </button>

                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;"
                              onsubmit="return confirm('Are you sure you want to delete this course?');">
                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Bootstrap Modal -->
<div class="modal fade" id="courseModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Add Master Course</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <form id="courseForm" method="post" enctype="multipart/form-data">
                <div class="modal-body">
                    <input type="hidden" id="Id" name="Id" />

                    <div class="mb-3">
                        <label class="form-label">Master Course Name</label>
                        <input type="text" class="form-control" id="CourseName" name="CourseName" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Status</label>
                        <select class="form-select" id="Status" name="Status">
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Thumbnail</label>
                        <input type="file" class="form-control" id="thumbnail" name="thumbnail" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        @if (TempData["Message"] != null)
            {
                <text>
                        alert("@TempData["Message"]");
                </text>
        }

            $(document).ready(function() {
                $('#courseTable').DataTable({
                    order: [[4, 'desc']] // sort by "Created At" column (index 4) descending by default
                });
            });

        function openAddModal() {
            document.getElementById("modalTitle").innerText = "Add Master Course";
            document.getElementById("courseForm").reset();
            document.getElementById("Id").value = "";
            document.getElementById("courseForm").action = "/MasterCourse/Add";
        }

        function openEditModal(id, courseName, status) {
            document.getElementById("modalTitle").innerText = "Edit Master Course";
            document.getElementById("Id").value = id;
            document.getElementById("CourseName").value = courseName;
            document.getElementById("Status").value = status;
            document.getElementById("courseForm").action = "/MasterCourse/Edit";
        }
    </script>
}