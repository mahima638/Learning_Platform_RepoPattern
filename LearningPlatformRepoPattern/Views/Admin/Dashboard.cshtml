@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid">
    <div class="row">

        <!-- Sidebar -->
        <div class="col-md-3 col-lg-2 bg-dark text-white min-vh-100 p-3">

            <h4 class="mb-4">Admin Panel</h4>

            <div class="nav flex-column">
                <a class="nav-link text-white" href="#" onclick="loadMasterCourse()">
                    Master Course
                </a>

                <a class="nav-link text-white" href="#" onclick="loadSubCourse()">
                    Sub Course
                </a>

                <a class="nav-link text-white" href="#">
                    Add Topic
                </a>

                <a class="nav-link text-white" href="#">
                    Add Material
                </a>

                <a class="nav-link text-white" href="#">
                    Add Subscription
                </a>
                <a asp-controller="Account"
                   asp-action="Logout">
                    Logout
                </a>

            </div>

        </div>

        <!-- Main Content -->
        <div class="col-md-9 col-lg-10 p-4">

            <div id="adminContent">

                <h2>Admin Dashboard</h2>

                <p class="text-muted">
                    Welcome to the Learning Platform Admin Panel.
                </p>

            </div>

        </div>

    </div>
</div>
<script>
    function loadMasterCourse() {
        document.getElementById("adminContent").innerHTML =
            '<iframe src="/MasterCourse" style="width:100%; height:100vh; border:none;"></iframe>';
    }

    function loadSubCourse() {
        document.getElementById("adminContent").innerHTML =
            '<iframe src="/SubCourse" style="width:100%; height:100vh; border:none;"></iframe>';
    }
</script>