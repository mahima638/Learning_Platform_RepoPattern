@model List<LearningPlatformRepoPattern.Models.MyCourseViewModel>

@{
    ViewData["Title"] = "My Courses";
}

<!-- Bootstrap 5 -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet">

<style>
    .course-card {
        border: none;
        border-radius: 15px;
        overflow: hidden;
        transition: 0.3s;
    }

    .course-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15) !important;
    }

    .course-image {
        height: 220px;
        width: 100%;
        object-fit: cover;
    }

    .course-title {
        color: #1f2937;
        font-size: 22px;
    }

    .course-name {
        color: #555;
    }

    .amount {
        font-size: 18px;
    }
</style>

<div class="container py-5">

    <!-- Page Heading -->
    <div class="text-center mb-5">
        <h1 class="fw-bold display-5">My Courses</h1>

        <p class="text-secondary fs-5">
            Continue learning from your enrolled courses
        </p>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info text-center">
            <h5 class="alert-heading">
                No Courses Found
            </h5>

            <p class="mb-0">
                You have not enrolled in any courses yet.
            </p>
        </div>
    }
    else
    {
        <!-- Course Cards -->
        <div class="row g-4">

            @foreach (var course in Model)
            {
                <div class="col-12 col-md-6 col-lg-4">

                    <div class="card course-card h-100 shadow">

                        <!-- Course Image -->
                        <img src="@Url.Content("~/" + (course.Mthumbnail ?? "").TrimStart('/'))"
                             class="course-image"
                             alt="@course.Mname">

                        <div class="card-body p-4">

                            <!-- Sub Course Name -->
                            <h5 class="course-title fw-bold mb-3">
                                @course.Sname
                            </h5>

                            <!-- Master Course -->
                            <p class="course-name mb-2">
                                <strong>Course:</strong>
                                @course.Mname
                            </p>

                            <!-- Status -->
                            <p class="mb-2">
                                <strong>Status:</strong>

                                <span class="badge bg-success">
                                    @course.Sstatus
                                </span>
                            </p>

                            <!-- Amount -->
                            <p class="amount mb-4">
                                <strong>Amount:</strong>

                                <span class="text-success fw-bold">
                                    ₹@course.Samount
                                </span>
                            </p>

                            <!-- Play Button -->
                            <a asp-controller="MyCourses"
                               asp-action="WatchVideo"
                               asp-route-sid="@course.Sid"
                               asp-route-userId="@course.UserId"
                               class="btn btn-primary">

                                ▶ Play

                            </a>

                        </div>
                    </div>

                </div>
            }

        </div>
    }

</div>