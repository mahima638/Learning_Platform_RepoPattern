@model List<LearningPlatformRepoPattern.Models.SubCourse>
@using Microsoft.AspNetCore.Mvc.Rendering

<div class="container mt-4">

    @* @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    } *@

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Sub Course</h2>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#subCourseModal" onclick="openAddModal()">
            Add Sub Course
        </button>
    </div>

    <table class="table table-striped table-bordered" id="subCourseTable" style="width:100%">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Master Course</th>
                <th>Sub Course</th>
                <th>Amount</th>
                <th>Status</th>
                <th>Created At</th>
                <th>Created By</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.MasterCourse.CourseName</td>
                    <td>@item.SubCourseName</td>
                    <td>₹@item.Amount</td>
                    <td>
                        @if (item.Status == "Active")
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </td>
                    <td>@item.CreatedAt</td>
                    <td>@item.CreatedBy</td>
                    <td>
                        <button type="button" class="btn btn-sm btn-warning"
                                data-bs-toggle="modal" data-bs-target="#subCourseModal"
                                onclick="openEditModal(@item.Id, @item.MasterCourseId, '@item.SubCourseName', @item.Amount, '@item.Status')">
                            Edit
                        </button>

                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;"
                              onsubmit="return confirm('Are you sure you want to delete this sub course?');">
                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Bootstrap Modal -->
<div class="modal fade" id="subCourseModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Add Sub Course</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <form id="subCourseForm" method="post">
                <div class="modal-body">
                    <input type="hidden" id="Id" name="Id" />

                    <div class="mb-3">
                        <label class="form-label">Master Course</label>
                        <select class="form-select" id="MasterCourseId" name="MasterCourseId">
                            @foreach (var m in (SelectList)ViewBag.MasterCourseList)
                            {
                                <option value="@m.Value">@m.Text</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Sub Course</label>
                        <input type="text" class="form-control" id="SubCourseName" name="SubCourseName" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Amount</label>
                        <input type="number" step="0.01" class="form-control" id="Amount" name="Amount" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Status</label>
                        <select class="form-select" id="Status" name="Status">
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        @if (TempData["Message"] != null)
            {
                <text>
                        alert("@TempData["Message"]");
                </text>
        }


        $(document).ready(function() {
                $('#subCourseTable').DataTable({
                    order: [[5, 'desc']],
                    columnDefs: [
                        { orderable: false, targets: 7 }
                    ]
                });
        });

        function openAddModal() {
            document.getElementById("modalTitle").innerText = "Add Sub Course";
            document.getElementById("subCourseForm").reset();
            document.getElementById("Id").value = "";
            document.getElementById("subCourseForm").action = "/SubCourse/Add";
        }

        function openEditModal(id, masterCourseId, subCourseName, amount, status) {
            document.getElementById("modalTitle").innerText = "Edit Sub Course";
            document.getElementById("Id").value = id;
            document.getElementById("MasterCourseId").value = masterCourseId;
            document.getElementById("SubCourseName").value = subCourseName;
            document.getElementById("Amount").value = amount;
            document.getElementById("Status").value = status;
            document.getElementById("subCourseForm").action = "/SubCourse/Edit";
        }

        document.getElementById("courseForm").addEventListener("submit", function() {
            var btn = this.querySelector('button[type="submit"]');
            btn.disabled = true;
            btn.innerText = "Saving...";
        });
    </script>
}