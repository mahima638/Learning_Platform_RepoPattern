@model LearningPlatformRepoPattern.Models.WatchVideoViewModel

@{
    ViewData["Title"] = "Watch Video";

    var currentTopic = Model.TopicItems
        .FirstOrDefault(x => x.Topic.Id == Model.CurrentTopicId);

    var currentTopicName =
        currentTopic?.Topic.TopicName ?? "Topic";

    var currentVideoUrl =
        currentTopic?.Topic.VideoUrl ?? "";

    // Convert YouTube URL to Embed URL
    var embedUrl = currentVideoUrl;

    if (!string.IsNullOrEmpty(currentVideoUrl))
    {
        if (currentVideoUrl.Contains("youtube.com/watch?v="))
        {
            var videoId = currentVideoUrl
                .Split("v=")[1]
                .Split("&")[0];

            embedUrl =
                "https://www.youtube.com/embed/" + videoId;
        }
        else if (currentVideoUrl.Contains("youtu.be/"))
        {
            var videoId = currentVideoUrl
                .Split("youtu.be/")[1]
                .Split("?")[0];

            embedUrl =
                "https://www.youtube.com/embed/" + videoId;
        }
    }
}

<!-- Bootstrap 5 -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet">

<div class="container py-4">

    <!-- COURSE HEADER -->
    <div class="mb-4">

        <h2 class="fw-bold">
            @Model.Sname
        </h2>

        <p class="text-secondary mb-0">
            <strong>Course:</strong>
            @Model.Mname
        </p>

    </div>


    <div class="row g-4">

        <!-- ================================================= -->
        <!-- VIDEO SECTION -->
        <!-- ================================================= -->

        <div class="col-12 col-lg-8">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-primary text-white">

                    <h5 class="mb-0">
                        @currentTopicName
                    </h5>

                </div>

                <div class="card-body">

                    @if (!string.IsNullOrEmpty(embedUrl))
                    {
                        <div class="ratio ratio-16x9 bg-dark rounded overflow-hidden">

                            <iframe src="@embedUrl"
                                    title="@currentTopicName"
                                    class="w-100 h-100"
                                    frameborder="0"
                                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                    allowfullscreen>
                            </iframe>

                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning mb-0">

                            Video is not available
                            for this topic.

                        </div>
                    }

                </div>

            </div>

        </div>


        <!-- ================================================= -->
        <!-- TOPICS SECTION -->
        <!-- ================================================= -->

        <div class="col-12 col-lg-4">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-dark text-white">

                    <h5 class="mb-0">
                        Topics
                    </h5>

                </div>

                <div class="list-group list-group-flush">

                    @foreach (var item in Model.TopicItems)
                    {
                        if (item.IsUnlocked)
                        {
                            <a asp-controller="MyCourses"
                               asp-action="WatchVideo"
                               asp-route-sid="@Model.Sid"
                               asp-route-userId="@Model.UserId"
                               asp-route-tid="@item.Topic.Id"
                               class="list-group-item list-group-item-action @(item.Topic.Id == Model.CurrentTopicId ? "active" : "")">

                                <div class="d-flex justify-content-between align-items-center">

                                    <span>

                                        @if (item.IsCompleted)
                                        {
                                            <span class="text-success fw-bold">
                                                ✓
                                            </span>
                                        }
                                        else
                                        {
                                            <span>
                                                ▶
                                            </span>
                                        }

                                        @item.Topic.TopicName

                                    </span>


                                    @if (item.IsCompleted)
                                    {
                                        <span class="badge bg-success">
                                            Completed
                                        </span>
                                    }

                                </div>

                            </a>
                        }
                        else
                        {
                            <div class="list-group-item text-secondary">

                                <div class="d-flex align-items-start">

                                    <span class="me-2">
                                        🔒
                                    </span>

                                    <div>

                                        <div class="fw-semibold">
                                            @item.Topic.TopicName
                                        </div>

                                        <small>
                                            Pass previous topic MCQ
                                            with 3/3 to unlock.
                                        </small>

                                    </div>

                                </div>

                            </div>
                        }
                    }

                </div>

            </div>

        </div>

    </div>


    <!-- ================================================= -->
    <!-- NAVIGATION -->
    <!-- ================================================= -->

    <div class="card shadow-sm border-0 mt-4">

        <div class="card-body p-0">

            <ul class="nav nav-tabs">

                <!-- ASSIGNMENT TAB -->

                <li class="nav-item">

                    <a class="nav-link active"
                       href="#assignmentSection">

                        📄 Assignment

                    </a>

                </li>


                <!-- MCQ TAB -->

                <li class="nav-item">

                    <button type="button"
                            class="nav-link"
                            data-bs-toggle="modal"
                            data-bs-target="#mcqModal">

                        📝 MCQ

                    </button>

                </li>


                <!-- CERTIFICATE TAB -->

                <li class="nav-item">

                    @if (Model.CertificateUnlocked)
                    {
                        <button type="button"
                                class="nav-link certificate-button"
                                data-sid="@Model.Sid"
                                data-userid="@Model.UserId">

                            🏆 Certificate

                        </button>
                    }
                    else
                    {
                        <span class="nav-link text-secondary">

                            🔒 Certificate

                        </span>
                    }

                </li>

            </ul>

        </div>

    </div>


    <!-- ================================================= -->
    <!-- ASSIGNMENT SECTION -->
    <!-- ================================================= -->

    <div id="assignmentSection"
         class="card shadow-sm border-0 mt-4">

        <div class="card-header bg-primary text-white">

            <h5 class="mb-0">

                📄 Assignment

            </h5>

        </div>


        <div class="card-body">

            @if (TempData["Message"] != null)
            {
                <div class="alert alert-success">

                    @TempData["Message"]

                </div>
            }


            <!-- DOWNLOAD ASSIGNMENT -->

            <div class="mb-4">

                <label class="form-label fw-semibold">

                    Download Assignment

                </label>

                <div>

                    <a asp-controller="MyCourses"
                       asp-action="DownloadAssignment"
                       asp-route-sid="@Model.Sid"
                       class="btn btn-primary">

                        ⬇ Download Assignment

                    </a>

                </div>

            </div>


            <!-- SUBMIT ASSIGNMENT -->

            <form asp-controller="MyCourses"
                  asp-action="SubmitAssignment"
                  method="post"
                  enctype="multipart/form-data">

                <input type="hidden"
                       name="sid"
                       value="@Model.Sid" />

                <input type="hidden"
                       name="userId"
                       value="@Model.UserId" />


                <div class="mb-3">

                    <label class="form-label fw-semibold">

                        Upload Assignment

                    </label>

                    <input type="file"
                           name="assignmentFile"
                           class="form-control"
                           required />

                </div>


                <button class="btn btn-success"
                        type="submit">

                    ✓ Submit Assignment

                </button>

            </form>

        </div>

    </div>

</div>


<!-- ===================================================== -->
<!-- MCQ MODAL -->
<!-- ===================================================== -->

<div class="modal fade"
     id="mcqModal"
     tabindex="-1"
     aria-labelledby="mcqModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">

        <div class="modal-content">


            <!-- MCQ HEADER -->

            <div class="modal-header bg-primary text-white">

                <h5 class="modal-title"
                    id="mcqModalLabel">

                    📝 MCQ Test

                </h5>


                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <!-- MCQ BODY -->

            <div class="modal-body">

                @if (Model.Mcqs != null &&
                     Model.Mcqs.Count > 0)
                {
                    <form asp-controller="MyCourses"
                          asp-action="SubmitMcq"
                          method="post">


                        <input type="hidden"
                               name="sid"
                               value="@Model.Sid" />


                        <input type="hidden"
                               name="userId"
                               value="@Model.UserId" />


                        <input type="hidden"
                               name="tid"
                               value="@Model.CurrentTopicId" />


                        @for (int i = 0;
                              i < Model.Mcqs.Count;
                              i++)
                        {
                            var mcq =
                                Model.Mcqs[i];


                            <div class="card border mb-4">

                                <div class="card-body">

                                    <h6 class="fw-bold mb-3">

                                        @(i + 1).
                                        @mcq.Question

                                    </h6>


                                    <!-- OPTION 1 -->

                                    <div class="form-check mb-2">

                                        <input class="form-check-input"
                                               type="radio"
                                               name="answers[@i]"
                                               value="@mcq.Option1"
                                               id="q@(i)o1"
                                               required />

                                        <label class="form-check-label"
                                               for="q@(i)o1">

                                            @mcq.Option1

                                        </label>

                                    </div>


                                    <!-- OPTION 2 -->

                                    <div class="form-check mb-2">

                                        <input class="form-check-input"
                                               type="radio"
                                               name="answers[@i]"
                                               value="@mcq.Option2"
                                               id="q@(i)o2" />

                                        <label class="form-check-label"
                                               for="q@(i)o2">

                                            @mcq.Option2

                                        </label>

                                    </div>


                                    <!-- OPTION 3 -->

                                    <div class="form-check mb-2">

                                        <input class="form-check-input"
                                               type="radio"
                                               name="answers[@i]"
                                               value="@mcq.Option3"
                                               id="q@(i)o3" />

                                        <label class="form-check-label"
                                               for="q@(i)o3">

                                            @mcq.Option3

                                        </label>

                                    </div>


                                    <!-- OPTION 4 -->

                                    <div class="form-check">

                                        <input class="form-check-input"
                                               type="radio"
                                               name="answers[@i]"
                                               value="@mcq.Option4"
                                               id="q@(i)o4" />

                                        <label class="form-check-label"
                                               for="q@(i)o4">

                                            @mcq.Option4

                                        </label>

                                    </div>

                                </div>

                            </div>
                        }


                        <!-- SUBMIT MCQ -->

                        <div class="text-center">

                            <button type="submit"
                                    class="btn btn-success btn-lg">

                                ✓ Submit Test

                            </button>

                        </div>

                    </form>
                }
                else
                {
                    <div class="alert alert-warning">

                        No MCQ questions available
                        for this topic.

                    </div>
                }


                <!-- MCQ RESULT -->
                @if (TempData["McqMessage"] != null)
                {
                    <div class="alert @(Convert.ToBoolean(TempData["McqPassed"]) ? "alert-success" : "alert-danger") mt-3">

                        @TempData["McqMessage"]

                    </div>
                }

            </div>

        </div>

    </div>

</div>


<!-- ===================================================== -->
<!-- CERTIFICATE MODAL -->
<!-- ===================================================== -->

<div class="modal fade"
     id="certificateModal"
     tabindex="-1"
     aria-labelledby="certificateModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">

        <div class="modal-content">


            <!-- CERTIFICATE HEADER -->

            <div class="modal-header bg-warning">

                <h5 class="modal-title"
                    id="certificateModalLabel">

                    🏆 Certificate of Completion

                </h5>


                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <!-- CERTIFICATE BODY -->

            <div class="modal-body">

                <div id="certificateContainer"
                     class="text-center">

                    <div class="spinner-border text-primary"
                         role="status">

                        <span class="visually-hidden">

                            Loading...

                        </span>

                    </div>


                    <p class="mt-2">

                        Loading certificate...

                    </p>

                </div>

            </div>


            <!-- CERTIFICATE FOOTER -->

            <div class="modal-footer justify-content-center">

                <button type="button"
                        class="btn btn-primary"
                        id="printCertificateButton">

                    🖨 Print Certificate

                </button>


                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">

                    Close

                </button>

            </div>

        </div>

    </div>

</div>


<!-- ===================================================== -->
<!-- BOOTSTRAP JAVASCRIPT -->
<!-- ===================================================== -->

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>


<!-- ===================================================== -->
<!-- CERTIFICATE JAVASCRIPT -->
<!-- ===================================================== -->

<script src="~/js/certificate.js"></script>
<script src="~/js/certificate.js"></script>