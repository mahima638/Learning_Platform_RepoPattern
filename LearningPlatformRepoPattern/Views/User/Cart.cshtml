@model List<LearningPlatformRepoPattern.Models.SubCourse>

<div class="container mt-4">

    <h2 class="mb-4">My Cart</h2>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            Your cart is empty.
        </div>
    }
    else
    {
        <div class="row">

            <div class="col-md-8">

                @foreach (var course in Model)
                {
                    <div class="card mb-3 shadow-sm">
                        <div class="card-body">

                            <h5>
                                @course.MasterCourse.CourseName
                            </h5>

                            <p class="text-muted">
                                @course.SubCourseName
                            </p>

                            <strong>
                                @course.Amount
                            </strong>

                        </div>
                    </div>
                }

            </div>

            <div class="col-md-4">

                <div class="card shadow-sm">
                    <div class="card-body">

                        <h4>Cart Summary</h4>

                        <hr />

                        <h5>
                            Total:
                            @Model.Sum(c => c.Amount)
                        </h5>

                        <form asp-controller="User" asp-action="CreateOrder" method="post">
                            <button type="submit" class="btn btn-primary w-100 mt-3">
                                Proceed to Payment
                            </button>
                        </form>

                    </div>
                </div>

            </div>

        </div>
    }

</div>